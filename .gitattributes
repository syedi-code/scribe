# One line ending in the repository, whatever the checkout platform. Without
# this, a Windows checkout rewrites every file it touches to CRLF and Prettier
# reports the whole tree as unformatted.
* text=auto eol=lf

# Binary, and never to be line-ending-normalised or diffed as text.
*.png   binary
*.jpg   binary
*.webp  binary
*.pdf   binary
*.otf   binary
*.ttf   binary
*.woff  binary
*.woff2 binary

# Generated: keep it out of diffs and out of language statistics.
package-lock.json  linguist-generated=true -diff
