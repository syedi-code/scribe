{
	"name": "scribe",
	"description": "scribe-lm: ask the library a question, and see whether every quote in the answer is on the page it names.",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host --port 4572",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"format": "prettier --write .",
		"deploy:prod": "npm run build && wrangler pages deploy dist --project-name scribe --branch main"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260915.1",
		"@eslint/js": "^9.39.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^24.10.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"jsdom": "^29.1.1",
		"prettier": "^3.6.2",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.47.0",
		"vite": "^7.2.4",
		"vitest": "^5.0.1",
		"wrangler": "^4.90.0"
	},
	"dependencies": {
		"@ai-sdk/react": "^4.0.108",
		"ai": "^7.0.105",
		"pdfjs-dist": "^6.3.289",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	}
}
